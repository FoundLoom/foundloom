# Where waitlist signups are POSTed as { "email": "...", "product": "PocketPair" }.
# Until this is set, the form validates the address and then says plainly that
# no endpoint is connected, rather than showing a success message it has not
# earned. Point it at a Formspree form, a Google Apps Script, a Vercel
# function, or whatever you use.
NEXT_PUBLIC_WAITLIST_ENDPOINT=

# Contact form on /contact. Receives { name, email, subject, message }.
NEXT_PUBLIC_CONTACT_ENDPOINT=

# Google Search Console. Paste the content value of the HTML tag verification
# method (just the code, not the whole <meta> tag). Leave empty and no tag is
# added to the page.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google Analytics 4 measurement ID, in the form G-XXXXXXXXXX. Leave empty and
# no analytics script is loaded at all. If you set this, check whether your
# visitors' jurisdictions require cookie consent before loading analytics, and
# describe it on the /cookies page.
NEXT_PUBLIC_GA_ID=
